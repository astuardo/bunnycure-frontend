# BunnyCure Frontend - Environment Variables Template
# Copia este archivo a .env.local para desarrollo local

# URL del backend (Spring Boot)
VITE_API_BASE_URL=http://localhost:8080

# Nombre de la aplicación
VITE_APP_NAME=BunnyCure

# Google Analytics 4 (opcional para producción)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_GA_ID=

# ID de compilación / release (inyectado automáticamente en CI/CD)
VITE_APP_BUILD_ID=local-dev
