{
  "rewrites": [
    {
      "source": "/manifest-card.json",
      "destination": "/api/manifest-card.js"
    },
    {
      "source": "/api/manifest-card",
      "destination": "/api/manifest-card.js"
    },
    {
      "source": "/mi-tarjeta/:publicId",
      "destination": "/api/card-page.js?publicId=:publicId"
    },
    {
      "source": "/tarjeta/:publicId",
      "destination": "/api/card-page.js?publicId=:publicId"
    },
    {
      "source": "/pass/:publicId",
      "destination": "/api/card-page.js?publicId=:publicId"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/card-page.js": {
      "includeFiles": "dist/index.html"
    }
  },
  "headers": [
    {
      "source": "/(sw\\.js|pwa-sw\\.js|service-worker\\.js)",
      "headers": [
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
